<% layout("layouts/boilerplate.ejs")%>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-6 col-lg-5">
                <form method="POST" action="/items/new" enctype="multipart/form-data" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <input type="text" name="itemname" class="form-control" placeholder="Item name" required>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                            Item name is required.
                        </div>
                    </div>

                    <div class="mb-3">
                        <input type="tel" name="itemprice" class="form-control" placeholder="Item price" required>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                            Full Name is required.
                        </div>
                    </div>

                    <div class="mb-3">
                        <input type="file" name="itemimage" class="form-control" placeholder="Item image" required>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                            Image required.
                        </div>
                    </div>

                    <div class="mb-3">
                        <input type="text" name="category" class="form-control" placeholder="category" required>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                            Category required.
                        </div>
                    </div>
                    <button class="btn btn-dark add-btn">add</button>
                    <br><br>
                </form>
            </div>
        </div>
    </div>