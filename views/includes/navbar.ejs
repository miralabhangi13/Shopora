<style>
  .btn-search {
    background-color: #fe424d;
    color: #fff;
    border-radius: 10px;
    padding: 0 1rem 0 1rem;
  }

  .btn-search:hover {
    background-color: #fe424d;
    color: #fff;
  }

  .inp-search {
    border-radius: 10px;
    padding: 0.5rem, 3rem, 0.5rem, 3rem;
    font-size: 1rem;
  }
</style>
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/items">
  <img src="images/favicon.svg" alt="Logo" width="35" height="35" class="d-inline-block align-text-top">
</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/items">Explore</a>
      </div>
      <div class="navbar-nav ms-auto">
        <form class="d-flex"  id="form1" role="search" method="GET" action="/items/search">
          <input class="form-control me-2 inp-search" type="search" name="category" placeholder="Search product"
            aria-label="Search" />
          <button class="btn btn-search" id="searchInput" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
      </div>
      <div class="navbar-nav ms-auto">
        <% if(currUser){%>
        <a class="nav-link" href="/items/cart"><i class="fa-solid fa-cart-arrow-down"></i></a>
        <a class="nav-link" href="/items/new"><b>Add item</b></a>
        <%}%>
        <% if(!currUser) {%>
          <a class="nav-link" href="/signup"><b>Signup</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
          <%}%>
            <% if(currUser) {%>
              <a class="nav-link" href="/logout">Log out</a>
              <%}%>
      </div>
    </div>
  </div>
</nav>
  <script>
  const input = document.querySelector('input[name="category"]');
  const form1 = document.getElementById("form1");

  input.addEventListener("keydown", function (event) {
    if (event.key === "Enter") {
      event.preventDefault();
      form1.submit();
    }
  });
</script>
