<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Something went wrong!</h4>
        <p><%= message %></p> 
        <hr>
        <% if (process.env.NODE_ENV !== "production") { %>
            <p><strong>Technical Details:</strong></p>
            <p><%= err.stack %></p>
        <% } %>
    </div>
</div>